# Copy this file to `.env.local` for local development, or configure the same
# variables in the hosting platform's production environment.
# PostgreSQL 15+ is required. Use the Neon connection string for DATABASE_URL.

DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Auth.js production secret. Generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Public canonical URL used by Auth.js and verification-email links.
NEXTAUTH_URL="https://your-production-domain.example"

# Required for recipes, invoice extraction, and label scanning.
GROQ_API_KEY="gsk_replace-with-your-groq-api-key"

# Email verification (required before signup can create accounts).
# For Gmail, use smtp.gmail.com and a Google App Password, not your normal password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-shelflife-gmail@gmail.com"
SMTP_PASSWORD="your-16-character-google-app-password"
EMAIL_FROM="ShelfLife <your-shelflife-gmail@gmail.com>"

# Optional for hosts behind a reverse proxy when Auth.js reports UntrustedHost.
# AUTH_TRUST_HOST="true"
