// use prisma-next
enum AccountType {
  @@type("pg/text@1")

  CONSUMER = "consumer"
  BUSINESS = "business"
}

enum UserPlan {
  @@type("pg/text@1")

  CONSUMER_FREE = "consumer_free"
  CONSUMER_PLUS = "consumer_plus"
  BUSINESS_STARTER = "business_starter"
  BUSINESS_PRO = "business_pro"
  BUSINESS_GROWTH = "business_growth"
}

model User {
  id          Int         @id @default(autoincrement())
  email       String      @unique
  name        String?
  accountType AccountType @default(CONSUMER)
  plan        UserPlan    @default(CONSUMER_FREE)

  businessId  Int?
  business    Business?   @relation(fields: [businessId], references: [id])

  inventory InventoryItem[]
  consumption InventoryConsumption[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  passwordHash String?
}

model Business {
  id        Int      @id @default(autoincrement())
  name      String
  industry  String?

  users     User[]
  inventoryItems InventoryItem[]
  consumptionItems InventoryConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([name])
}

model InventoryItem {
  id         Int                        @id @default(autoincrement())
  user       User                       @relation(fields:[userId], references:[id])
  userId     Int
  businessId  Int?
  business   Business?  @relation(fields: [businessId], references: [id])
  name       String
  category   String
  quantity   Int
  unit       String
  expiryDate TimestamptzString
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()
}

model InventoryConsumption {
  id                 Int                        @id @default(autoincrement())
  userId             Int
  user               User                       @relation(fields: [userId], references: [id])
  businessId         Int?
  business           Business?                  @relation(fields: [businessId], references: [id])
  inventoryItemId    Int
  productName        String
  quantityUsed       Int
  unit               String
  normalizedQuantityUsed Float?
  consumedAt         TimestamptzString          @default(now())
}
